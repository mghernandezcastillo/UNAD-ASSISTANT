{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student profile data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "idDocument": { "type": "string" },
        "age": { "type": "number" },
        "program": { "type": "string" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "cead": { "type": "string" },
        "school": { "type": "string" },
        "zone": { "type": "string" },
        "center": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "name", "createdAt", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "A UNAD course",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "credits": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["courseId", "userId", "name", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A specific task for a course",
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "courseId": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in-progress", "completed"] },
        "type": { "type": "string", "enum": ["individual", "collaborative"] },
        "docUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["taskId", "courseId", "userId", "title", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Student profile documents"
    },
    "/users/{userId}/courses/{courseId}": {
      "schema": "Course",
      "description": "Courses belonging to a student"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks belonging to a student"
    }
  }
}
